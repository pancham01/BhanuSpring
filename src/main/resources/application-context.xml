<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	<bean name="add" class="com.bhanu.spring.model.Address">
		<property name="city" value="Noida" />
		<property name="state" value="UP" />
	</bean>



	<bean name="e1" class="com.bhanu.spring.model.Employee" scope = "singleton" autowire= "constructor">

		<constructor-arg name="name" value="Ansh" />
		<constructor-arg name="gender" value="Male" />
		<constructor-arg name="id" value="908" />
	
	</bean>





</beans>
